{
  "opencollection": "1.0.0",
  "info": {
    "name": "Engagedly Activities API",
    "version": "beta"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ClientKey",
      "value": "{{ClientKey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Activities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all public praises",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.engagedly.com/beta/activities/praises",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (starts at 1)"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of records per page (maximum 50)"
              }
            ]
          },
          "docs": "Returns a paginated list of all public praise activities in the organization."
        }
      ]
    }
  ],
  "bundled": true
}